{
  "manifest_version": 3,
  "name": "YouTube Side Comments",
  "version": "0.1.0",
  "description": "Shows a video's comments in a pane beside the player, so you can watch and read at once.",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/content.js"],
      "css": ["src/layout.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "YouTube Side Comments",
    "default_popup": "src/popup.html"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://www.youtube.com/*"],
  "web_accessible_resources": [
    {
      "resources": ["src/engine.js", "src/words.js", "src/adapter.js", "src/splitter.js", "src/toggle.js"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
